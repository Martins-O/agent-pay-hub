{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "target": "ES2021",
    "moduleResolution": "Node",
    "allowJs": false,
    "outDir": "dist",
    "baseUrl": ".",
    "types": ["vite/client", "node"],
    "paths": {
      "@agentpay/sdk": ["../sdk/dist/index.d.ts"],
      "@agentpay/types": ["../types/dist/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
