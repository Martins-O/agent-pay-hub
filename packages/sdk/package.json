{
  "name": "@agentpay/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --write 'src/**/*.ts'",
    "lint": "eslint 'src/**/*.ts'",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@agentpay/types": "workspace:*",
    "@noble/hashes": "^1.4.0",
    "cross-fetch": "^3.1.8",
    "ulid": "^2.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "vitest": "^1.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "TypeScript client SDK for AgentPay Hub",
  "keywords": ["solana", "payments", "agent", "sdk"],
  "license": "MIT"
}
