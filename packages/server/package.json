{
  "name": "@agentpay/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "clean": "rimraf dist",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev --skip-generate",
    "prisma:migrate:deploy": "prisma migrate deploy --skip-generate",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@agentpay/types": "workspace:*",
    "@fastify/sensible": "^5.3.1",
    "@prisma/client": "^5.14.0",
    "@solana/web3.js": "^1.92.5",
    "argon2": "^0.44.0",
    "@noble/ed25519": "^2.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.3.2",
    "bs58": "^6.0.0",
    "prom-client": "^14.2.0",
    "undici": "^6.11.1",
    "pino": "^8.17.2",
    "ulid": "^2.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "pino-pretty": "^10.3.1",
    "prisma": "^5.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2",
    "vitest": "^1.5.0"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
